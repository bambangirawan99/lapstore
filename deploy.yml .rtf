\f0\fs24 \cf0 name: Deploy Buku Kas ke GitHub Pages\
\
on:\
  push:\
    branches: ["main"]\
  workflow_dispatch:\
\
permissions:\
  contents: read\
  pages: write\
  id-token: write\
\
concurrency:\
  group: "pages"\
  cancel-in-progress: false\
\
jobs:\
  build:\
    runs-on: ubuntu-latest\
    steps:\
      - name: Checkout kode\
        uses: actions/checkout@v4\
\
      - name: Setup Node.js\
        uses: actions/setup-node@v4\
        with:\
          node-version: 20\
\
      - name: Cegah deploy kalau Supabase belum dikonfigurasi\
        run: |\
          if grep -q "GANTI_DENGAN_SUPABASE" index.html; then\
            echo "::error::index.html masih berisi placeholder SUPABASE_URL / SUPABASE_ANON_KEY. Isi dulu sesuai README.md sebelum push ke branch main."\
            exit 1\
          fi\
          echo "Konfigurasi Supabase sudah diisi, lanjut."\
\
      - name: Cek sintaks JavaScript di index.html\
        run: |\
          node -e "\
            const fs = require('fs');\
            const html = fs.readFileSync('index.html', 'utf-8');\
            const scripts = [...html.matchAll(/<script>([\\s\\S]*?)<\\/script>/g)].map(m => m[1]);\
            fs.writeFileSync('_check.js', scripts.join('\\n;\\n'));\
          "\
          node --check _check.js\
          rm -f _check.js\
          echo "Sintaks JavaScript valid."\
\
      - name: Setup GitHub Pages\
        uses: actions/configure-pages@v5\
\
      - name: Upload artifact situs\
        uses: actions/upload-pages-artifact@v3\
        with:\
          path: "."\
\
  deploy:\
    needs: build\
    environment:\
      name: github-pages\
      url: $\{\{ steps.deployment.outputs.page_url \}\}\
    runs-on: ubuntu-latest\
    steps:\
      - name: Deploy ke GitHub Pages\
        id: deployment\
        uses: actions/deploy-pages@v4}